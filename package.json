{
  "name": "ticket-guard-action",
  "version": "1.0.0",
  "private": true,
  "description": "Traceability enforcer—validates business state, labels, and lifecycle status of issues referenced in pull requests.",
  "keywords": [
    "audit-readiness",
    "automation",
    "change-management",
    "ci-cd",
    "compliance",
    "devsecops",
    "fast",
    "github-actions",
    "github-issues",
    "governance",
    "issue-tracking",
    "policy-as-code",
    "pr-lint",
    "pull-request",
    "quality-gate",
    "soc2",
    "ticket-guard",
    "ticket-validation",
    "traceability",
    "zero-dependency"
  ],
  "homepage": "https://github.com/illia-m-b/ticket-guard-action#readme",
  "bugs": {
    "url": "https://github.com/illia-m-b/ticket-guard-action/issues",
    "email": "illiamb@duck.com"
  },
  "license": "MIT",
  "author": {
    "name": "Illia Brashkin",
    "email": "illiamb@duck.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illia-m-b/ticket-guard-action.git"
  },
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --no-error-on-unmatched-pattern",
    "fmt:ck": "oxfmt --check --no-error-on-unmatched-pattern",
    "lint": "oxlint --fix --no-error-on-unmatched-pattern",
    "lint:agents": "dogent --hints --offline --verbose AGENTS.md",
    "lint:ck": "oxlint --no-error-on-unmatched-pattern",
    "lint:reuse": "reuse lint",
    "lint:yaml": "yamllint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "@yegor256/dogent": "0.13.3",
    "eslint-plugin-security": "4.2.1",
    "lefthook": "2.2.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "rollup-plugin-license": "3.7.2",
    "tsdown": "0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
