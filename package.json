{
  "name": "ticket-guard-action",
  "version": "1.0.0",
  "private": true,
  "description": "Traceability enforcer—validates business state, labels, and lifecycle status of issues referenced in pull requests.",
  "keywords": [
    "audit-readiness",
    "automation",
    "change-management",
    "ci-cd",
    "compliance",
    "devsecops",
    "fast",
    "github-actions",
    "github-issues",
    "governance",
    "issue-tracking",
    "policy-as-code",
    "pr-lint",
    "pull-request",
    "quality-gate",
    "soc2",
    "ticket-guard",
    "ticket-validation",
    "traceability",
    "zero-dependency"
  ],
  "homepage": "https://github.com/illia-m-b/ticket-guard-action#readme",
  "bugs": {
    "url": "https://github.com/illia-m-b/ticket-guard-action/issues",
    "email": "illiamb@duck.com"
  },
  "license": "MIT",
  "author": {
    "name": "Illia Brashkin",
    "email": "illiamb@duck.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illia-m-b/ticket-guard-action.git"
  },
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --no-error-on-unmatched-pattern",
    "fmt:ck": "oxfmt --check --no-error-on-unmatched-pattern",
    "lint:agents": "dogent --hints --offline --verbose AGENTS.md",
    "lint:ts": "eslint --cache --exit-on-fatal-error --no-warn-ignored --flag=unstable_native_nodejs_ts_config",
    "lint:ts:check": "pnpm lint:ts --max-warnings=0",
    "lint:ts:fix": "pnpm lint:ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "tsc"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "@yegor256/dogent": "0.13.3",
    "eslint": "10.14.0",
    "eslint-plugin-package-json": "1.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.78.0",
    "rollup-plugin-license": "3.7.1",
    "tsdown": "0.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
