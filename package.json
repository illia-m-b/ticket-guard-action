{
  "name": "ticket-guard-action",
  "version": "0.0.0",
  "private": true,
  "description": "Traceability enforcer—validates business state, labels, and lifecycle status of issues referenced in pull requests.",
  "keywords": [
    "github-actions",
    "traceability",
    "issue-tracking",
    "ticket-guard",
    "ticket-validation",
    "pull-request",
    "pr-lint",
    "compliance",
    "devsecops",
    "governance",
    "change-management",
    "audit-readiness",
    "soc2",
    "github-issues",
    "quality-gate",
    "ci-cd",
    "automation",
    "policy-as-code",
    "zero-dependency",
    "fast"
  ],
  "homepage": "https://github.com/illia-m-b/ticket-guard-action#readme",
  "bugs": {
    "url": "https://github.com/illia-m-b/ticket-guard-action/issues",
    "email": "illiamb@duck.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illia-m-b/ticket-guard-action.git"
  },
  "license": "MIT",
  "author": {
    "name": "Illia Brashkin",
    "email": "illiamb@duck.com"
  },
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "format:code": "prettier --ignore-unknown --log-level=warn",
    "format:code:check": "pnpm format:code --check .",
    "format:code:fix": "pnpm format:code --cache --cache-strategy=metadata --write",
    "lint:agents": "dogent --hints --offline AGENTS.md",
    "lint:ts": "eslint --cache --exit-on-fatal-error --no-warn-ignored --flag=unstable_native_nodejs_ts_config",
    "lint:ts:check": "pnpm lint:ts --max-warnings=0",
    "lint:ts:fix": "pnpm lint:ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "tsc"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "@yegor256/dogent": "0.13.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-package-json": "1.10.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-jsdoc": "1.8.1",
    "rollup-plugin-license": "3.7.1",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "error"
    }
  }
}
